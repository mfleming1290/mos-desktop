{
  "name": "mos-desktop",
  "version": "1.0.0",
  "allowScripts": {
    "@playwright/test": true
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "description": "One MOS-first application with embedded and same-origin authenticated standalone presentations sharing scoped personal services. Neither frontend owns native process lifetime.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:design-ui": "node tests/design-ui.cjs",
    "test:shell-ui": "node tests/shell-ui.cjs",
    "test": "npm --prefix page test",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --project=auth",
    "test:e2e:list": "playwright test --list",
    "test:personal-ui": "node tests/personal-ui.cjs",
    "test:backend": "python3 -m unittest discover -s backend -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfleming1290/mos-desktop.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mfleming1290/mos-desktop/issues"
  },
  "homepage": "https://github.com/mfleming1290/mos-desktop#readme"
}
