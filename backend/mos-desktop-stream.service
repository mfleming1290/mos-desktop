[Unit]
Description=MOS Desktop scoped Selkies personal session
RequiresMountsFor=/home/matt
After=local-fs.target network.target
ConditionPathIsMountPoint=/home/matt

[Service]
Type=simple
User=matt
Group=matt
WorkingDirectory=/home/matt
EnvironmentFile=/etc/mos-desktop/stream.env
RuntimeDirectory=mos-desktop-stream
RuntimeDirectoryMode=0700
ExecStart=/bin/bash /opt/mos-desktop/streaming-backend/run-stream-session.sh
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/matt
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
TasksMax=128
MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
